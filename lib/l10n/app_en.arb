  "rulesHeader": "THE RULES",
  "rulesBack": "Back",
  "rulesHeroTitle": "The game of lies",
  "rulesHeroIntro": "Perudo, Dudo, Cacho… call it what you like. The dice don't lie. The pirates do.",
  "rulesShowcaseCaption": "Five dice, one wild paco, and no reason to tell the truth.",
  "rulesGoalTitle": "The goal",
  "rulesGoalBody": "Be the last pirate standing with at least one die. Each round you bet on what the cups hide. Whoever gets it wrong loses a die.",
  "rulesCupTitle": "Your cup",
  "rulesCupBody": "Everyone gets five dice and hides them under the cup. You may only look at your own.",
  "rulesPacoTitle": "Pacos are jokers",
  "rulesPacoBody": "A paco (1) counts as any face. It only counts as a paco when the bid is about pacos. So a paco is worth two plain dice when raising.",
  "rulesBidTitle": "The bid",
  "rulesBidBody": "A bid is two numbers: a quantity and a face.",
  "rulesBidQuote": "\"There are at least 4 fives on the table.\"",
  "rulesBidExplain": "Here the pirate claims at least four dice of value 5 across the whole table. The pacos count too.",
  "rulesRaiseTitle": "Raising",
  "rulesRaiseIntro": "The next bid must always be stronger:",
  "rulesRaiseSameFace": "More dice on the same face: 4 fives → 5 fives.",
  "rulesRaiseHigherFace": "Same count, higher face: 4 fives → 4 sixes.",
  "rulesRaiseTowardPaco": "Toward the pacos: at least half, rounded up: 4 fives → 2 pacos.",
  "rulesRaiseFromPaco": "From the pacos: double plus one: 2 pacos → 5 dice of any face.",
  "rulesConvert45": "4 fives",
  "rulesConvert2Paco": "2 pacos",
  "rulesConvert5F2": "5 twos",
  "rulesConvert5F6": "5 sixes",
  "rulesConvert3Paco": "3 pacos",
  "rulesDudoTitle": "Dudo!",
  "rulesDudoBody": "Instead of raising, you may call the last bid a lie. Everyone lifts the cup and you count.",
  "rulesDudoHoldsTitle": "The bid stands",
  "rulesDudoHoldsBody": "The doubter loses a die.",
  "rulesDudoWrongTitle": "The bid is wrong",
  "rulesDudoWrongBody": "The bidder loses a die.",
  "rulesCalzaTitle": "Calza — optional",
  "rulesCalzaBody": "You may also announce the count is exactly right. That's the calza.",
  "rulesCalzaAllOrNothing": "All or nothing",
  "rulesCalzaAllOrNothingBody": "Exact count: you win a die (up to five). Wrong count: you lose one. Calza can be turned off before the game.",
  "rulesEndTitle": "The end",
  "rulesEndBody": "A pirate who loses the last die is overboard. The last survivor wins the tavern. The round's loser opens the next round.",
  "rulesPalificoTitle": "Palifico",
  "rulesPalificoBody": "A pirate who loses their second-to-last die triggers palifico: the next round plays on a single face, forced by the opening bid.",
  "rulesPalificoFaceTitle": "Forced face",
  "rulesPalificoFaceBody": "The first bid picks the face and opens with at least two dice. Every later bid raises the count on that same face; the face can't change.",
  "rulesPalificoPacoTitle": "Paco, no jokers",
  "rulesPalificoPacoBody": "During palifico, pacos count only as pacos: no wild value.",
  "rulesPalificoOnceTitle": "One round only",
  "rulesPalificoOnceBody": "Next round, bidding returns to normal even if the pirate still holds one die. And if anyone drops to one die later, palifico triggers again.",
  "rulesTipQuote": "The best bluff is the one nobody wants to pay for.",
  "rulesUnderstood": "Got it",

