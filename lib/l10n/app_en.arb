  "rulesHeader": "RULES OF THE GAME",
  "rulesBack": "Back to home",
  "rulesHeroTitle": "Perudo rules",
  "rulesHeroIntro": "Whatever you call it, the dice stay quiet and the pirates tell tales.",
  "rulesShowcaseCaption": "Five dice, one wild paco, and bluffing at the heart of it.",
  "rulesGoalTitle": "Your mission",
  "rulesGoalBody": "Keep at least one die until the end. Each round, bid on the hidden dice. Whoever is wrong loses one.",
  "rulesCupTitle": "Your cup",
  "rulesCupBody": "Each pirate gets five dice and hides them under their cup. You only see your own.",
  "rulesPacoTitle": "Pacos are wild",
  "rulesPacoBody": "A paco (1) counts as any face unless the bid is on pacos, when it only counts as a paco. To raise from a regular face to pacos, bid at least half the quantity, rounded up. To raise from pacos, double the quantity and add one die.",
  "rulesBidTitle": "Make a bid",
  "rulesBidBody": "You announce how many dice show which face.",
  "rulesBidQuote": "\"Four fives or more are hiding under the cups.\"",
  "rulesBidExplain": "The pirate stakes their word on at least four fives. Pacos can help make up the count.",
  "rulesBidOpeningNote": "Outside palifico, you can't open a round with pacos.",
  "rulesRaiseTitle": "Raise the bid",
  "rulesRaiseIntro": "Each new bid must beat the previous one:",
  "rulesRaiseSameFace": "Keep the face, raise the count: 4 fives → 5 fives.",
  "rulesRaiseHigherFace": "Keep the quantity and choose a higher face: 4 fives → 4 sixes.",
  "rulesRaiseTowardPaco": "Head for pacos: bid at least half the dice, rounded up: 4 fives → 2 pacos.",
  "rulesRaiseFromPaco": "From pacos, double the quantity and add one die: 2 pacos → 5 dice, any face.",
  "rulesConvert45": "4 fives",
  "rulesConvert2Paco": "2 pacos",
  "rulesConvert5F2": "5 twos",
  "rulesConvert5F6": "5 sixes",
  "rulesConvert3Paco": "3 pacos",
  "rulesDudoTitle": "Dudo!",
  "rulesDudoBody": "Call Dudo to challenge the last bid: everyone lifts their cup, then you count.",
  "rulesDudoHoldsTitle": "The bid stands",
  "rulesDudoHoldsBody": "The player who challenged the bid loses a die.",
  "rulesDudoWrongTitle": "The bid doesn't hold",
  "rulesDudoWrongBody": "The player who made the bid loses a die.",
  "rulesCalzaTitle": "Calza: your choice",
  "rulesCalzaBody": "You can call the count exactly right: that's a calza.",
  "rulesCalzaAllOrNothing": "A die gained or lost",
  "rulesCalzaAllOrNothingBody": "If the count is exact, you gain a die, up to five. Otherwise, you lose one. Calza can be switched off before the game.",
  "rulesEndTitle": "Last pirate standing",
  "rulesEndBody": "Out of dice? Overboard! The last pirate afloat wins the tavern; the round's loser opens the next one.",
  "rulesPalificoTitle": "Palifico",
  "rulesPalificoBody": "A pirate who loses their second-to-last die triggers palifico: the next round plays on a single face, forced by the opening bid.",
  "rulesPalificoFaceTitle": "Face picked by the opening bid",
  "rulesPalificoFaceBody": "The first bid sets the face and must be at least two dice. After that, you can't change course: only the quantity can go up.",
  "rulesPalificoPacoTitle": "Pacos aren't wild",
  "rulesPalificoPacoBody": "In palifico, pacos lose their wild power and count only as pacos.",
  "rulesPalificoOnceTitle": "Palifico lasts one round",
  "rulesPalificoOnceBody": "Palifico lasts one round. Then the normal rules return, even if a pirate has only one die. If someone drops to one die later, a new palifico begins.",
  "rulesTipQuote": "The best bluff is the one no one dares to challenge.",
  "rulesUnderstood": "Got it",

